@model D_S_Grok.Models.ProfileViewModel

@{
    ViewData["Title"] = "Profile Settings";
}

<div class="container mt-4">

    <div class="challenge-hero mb-4">
        <div>
            <span class="challenge-eyebrow">Account Settings</span>

            <h1>Profile Settings</h1>

            <p>
                Manage your username, password, and view your learning identity
                inside D.S-Grok.
            </p>
        </div>

        <div class="challenge-xp-badge">
            👤
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success mb-4">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger mb-4">
            @TempData["Error"]
        </div>
    }

    <div class="profile-stats-grid mb-4">

        <div class="dashboard-stat-card xp-card">
            <div class="stat-icon">⭐</div>
            <div>
                <span class="stat-label">Total XP</span>
                <h2>@Model.TotalXP</h2>
            </div>
        </div>

        <div class="dashboard-stat-card level-card">
            <div class="stat-icon">🏆</div>
            <div>
                <span class="stat-label">Current Level</span>
                <h2>@Model.CurrentLevel</h2>
            </div>
        </div>

        <div class="dashboard-stat-card achievement-card">
            <div class="stat-icon">🎖️</div>
            <div>
                <span class="stat-label">Achievements</span>
                <h2>@Model.AchievementCount</h2>
            </div>
        </div>

    </div>

    <div class="profile-settings-grid">

        <div class="profile-settings-card">
            <h3>Change Username</h3>
            <p>Update the name shown across your dashboard and leaderboard.</p>

            <form method="post" action="/Account/UpdateProfile">
                <div class="mb-3">
                    <label class="form-label">Username</label>
                    <input asp-for="Username"
                           class="form-control"
                           autocomplete="username" />
                </div>

                <button type="submit" class="btn btn-primary">
                    Save Username
                </button>
            </form>
        </div>

        <div class="profile-settings-card">
            <h3>Change Password</h3>
            <p>Use a password that is easy for you to remember but hard for others to guess.</p>

            <form method="post" action="/Account/ChangePassword">

                <input type="hidden" asp-for="Username" />

                <div class="mb-3">
                    <label class="form-label">Current Password</label>
                    <input asp-for="CurrentPassword"
                           type="password"
                           class="form-control" />
                </div>

                <div class="mb-3">
                    <label class="form-label">New Password</label>
                    <input asp-for="NewPassword"
                           type="password"
                           class="form-control" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Confirm New Password</label>
                    <input asp-for="ConfirmNewPassword"
                           type="password"
                           class="form-control" />
                </div>

                <button type="submit" class="btn btn-primary">
                    Update Password
                </button>
            </form>
        </div>

    </div>

</div>