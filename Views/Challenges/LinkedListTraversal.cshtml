@{
    ViewData["Title"] = "Linked List Traversal Challenge";
}

<div class="challenge-arena challenge-module-arena">

    <div id="challengeMentorBanner" class="challenge-npc-banner">
    <div class="npc-avatar">🧙</div>

    <div class="npc-dialog-content">
        <span class="npc-name">Challenge Mentor</span>

        <div id="challengeFeedback">
            Click <strong>Add Node</strong> to create the first node in the linked list.
        </div>
    </div>
</div>

    <div class="lesson-top-bar">

        <button type="button"
                class="arena-exit-btn"
                onclick="openQuitModal()">
            ← Exit
        </button>

        <div class="lesson-status">
            Linked List Traversal Challenge
        </div>

        <form method="post"
              action="/Challenges/CompleteChallenge"
              class="arena-complete-form">

            <input type="hidden"
                   name="challengeId"
                   value="1" />

            <button id="completeChallengeBtn"
                    type="submit"
                    class="arena-complete-btn"
                    disabled>
                Complete
            </button>
        </form>

    </div>

    <div class="arena-visualizer-card">

        <div class="pointer-stage linkedlist-stage">
            <svg id="linkedListSvg"
                 viewBox="0 0 1000 340"
                 preserveAspectRatio="xMidYMid meet">

                <defs>
                    <linearGradient id="linkedNodeGradient" x1="0" y1="0" x2="1" y2="1">
                        <stop offset="0%" stop-color="#ffffff" />
                        <stop offset="100%" stop-color="#eef4ff" />
                    </linearGradient>

                    <filter id="linkedSoftShadow" x="-20%" y="-20%" width="140%" height="140%">
                        <feDropShadow dx="0" dy="8" stdDeviation="8"
                                      flood-color="#202E53"
                                      flood-opacity="0.16" />
                    </filter>

                    <marker id="arrowhead"
                            markerWidth="12"
                            markerHeight="12"
                            refX="10"
                            refY="6"
                            orient="auto">
                        <polygon points="0 0, 12 6, 0 12"
                                 fill="#06b6d4" />
                    </marker>
                </defs>

                <text id="emptyText"
                      x="350"
                      y="165"
                      font-size="24"
                      fill="#6C757D">
                    Linked list is currently empty
                </text>
            </svg>
        </div>

        <div class="lesson-command-bar">

            <button id="addNodeBtn"
                    class="lesson-action-btn">
                Add Node
            </button>

            <button id="traverseBtn"
                    class="lesson-action-btn"
                    disabled>
                Traverse
            </button>

            <button id="resetListBtn"
                    class="lesson-action-btn secondary">
                Reset
            </button>

        </div>

    </div>

    <div class="lesson-console expandable-code-console" id="traversalCodeConsole">
    <div class="console-header code-console-toggle"
         onclick="toggleTraversalCodeConsole()">
        <span>C++ Traversal Code</span>
        <span id="traversalCodeToggleText">Expand ⬆</span>
    </div>

    <pre class="cpp-code-box"><code id="linkedListCodeBlock">
Node* current = head;

while (current != nullptr) {
    cout << current->data;
    current = current->next;
}
</code></pre>
</div>

</div>

<div id="quitModal" class="quit-modal-overlay">
    <div class="quit-modal-card">
        <h3>Quit this module?</h3>

        <p>
            Are you sure you want to quit? Your current progress in this module may not be saved.
        </p>

        <div class="quit-modal-actions">
            <button type="button"
                    class="btn btn-secondary"
                    onclick="closeQuitModal()">
                No, Continue
            </button>

            <a id="quitConfirmLink"
               class="btn btn-danger"
               href="#">
                Yes, Quit
            </a>
        </div>
    </div>
</div>
<script>
    const quitDestination = "/Challenges";
</script>
<script>
    function openQuitModal() {
        document.getElementById("quitConfirmLink").href = quitDestination;
        document.getElementById("quitModal").classList.add("active");
    }

    function closeQuitModal() {
        document.getElementById("quitModal").classList.remove("active");
    }
</script>

<style>
body:has(.challenge-arena) {
    overflow-x: hidden;
}

body:has(.challenge-arena) header,
body:has(.challenge-arena) nav,
body:has(.challenge-arena) footer {
    display: none !important;
}

body:has(.challenge-arena) main {
    padding: 0 !important;
    margin: 0 !important;
    max-width: none !important;
}
</style>

<script>
    function toggleTraversalCodeConsole() {
        const arena = document.querySelector(".challenge-module-arena");
        const consoleBox = document.getElementById("traversalCodeConsole");
        const toggleText = document.getElementById("traversalCodeToggleText");

        arena.classList.toggle("code-expanded");
        consoleBox.classList.toggle("expanded");

        toggleText.textContent = consoleBox.classList.contains("expanded")
            ? "Minimize ⬇"
            : "Expand ⬆";

        if (window.refreshTraversalCodeConsole) {
            window.refreshTraversalCodeConsole();
        }
    }
</script>

@section Scripts {
    <script src="~/js/linkedlist-visualizer.js" asp-append-version="true"></script>
}