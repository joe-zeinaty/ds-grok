@{
    ViewData["Title"] = "Privacy Policy";
}

<div class="container mt-4">

    <div class="privacy-card">

        <h1>Privacy Policy & Intellectual Property Notice</h1>

        <p class="privacy-updated">
            Last Updated: June @DateTime.Now.Year
        </p>

        <hr />

        <h3>Project Information</h3>

        <p>
            D.S GROK is an educational web application developed as part of an
            academic project for the study and teaching of Data Structures,
            with a particular focus on pointers and linked lists through
            interactive visualization and game-based learning techniques.
        </p>

        <h3>Intellectual Property</h3>

        <p>
            This software, including all source code, visual assets,
            documentation, educational content, user interface designs,
            visualizations, and associated materials, is the intellectual
            property of The American University of Cyprus <strong>AUCY</strong> and/or the project
            author unless otherwise stated.
        </p>

        <p>
            Unauthorized reproduction, modification, distribution,
            commercialization, or republication of any part of this software
            is prohibited without prior written permission from the rightful
            copyright holder.
        </p>

        <h3>Educational Use</h3>

        <p>
            This application has been developed exclusively for educational,
            research, and demonstration purposes. Any deployment beyond the
            scope of academic evaluation may require additional permissions
            and licensing considerations.
        </p>

        <h3>Data Collection</h3>

        <p>
            D.S GROK stores only the information required to support user
            authentication, learning progress tracking, achievement systems,
            quiz results, challenge completion records, and leaderboard
            functionality.
        </p>

        <p>
            No personal information is shared with third parties and no user
            data is sold, rented, or otherwise distributed.
        </p>

