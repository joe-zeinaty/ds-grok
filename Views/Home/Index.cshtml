@{
    ViewData["Title"] = "Dashboard";
}

<div class="dashboard-container">
    <h1 class="dashboard-title">Welcome back, @ViewBag.Username</h1>

    <div class="dashboard-grid">

    <div class="dashboard-stat-card xp-card">
        <div class="stat-icon">
            ⭐
        </div>

        <div>
            <span class="stat-label">Total XP</span>
            <h2>@ViewBag.TotalXP</h2>
        </div>
    </div>

    <div class="dashboard-stat-card level-card">
        <div class="stat-icon">
            🏆
        </div>

        <div>
            <span class="stat-label">Current Level</span>
            <h2>@ViewBag.CurrentLevel</h2>
        </div>
    </div>

    <div class="dashboard-stat-card achievement-card">
        <div class="stat-icon">
            🎖️
        </div>

        <div>
            <span class="stat-label">Achievements</span>
            <h2>@ViewBag.AchievementCount</h2>
        </div>
    </div>
    <div class="dashboard-stat-card streak-card">
    <div class="stat-icon">
        🔥
    </div>

    <div>
        <span class="stat-label">Daily Streak</span>
        <h2>@ViewBag.DailyStreak Days</h2>
    </div>
</div>

</div>

    <div class="dashboard-card">
        <h3>Overall Progress</h3>

        <div class="progress mb-2">
            <div class="progress-bar"
                 role="progressbar"
                 style="width: @ViewBag.ProgressPercentage%;">
                @ViewBag.ProgressPercentage%
            </div>
        </div>
    </div>

    <br />

<div class="dashboard-progress-breakdown mt-4">

    <div class="progress-breakdown-card">
        <div class="progress-breakdown-icon">📘</div>

        <div>
            <h5>Lessons</h5>
            <p>@ViewBag.CompletedLessons / @ViewBag.TotalLessons complete</p>
        </div>
    </div>

    <div class="progress-breakdown-card">
        <div class="progress-breakdown-icon">⚔️</div>

        <div>
            <h5>Challenges</h5>
            <p>@ViewBag.CompletedChallenges / @ViewBag.TotalChallenges complete</p>
        </div>
    </div>

    <div class="progress-breakdown-card">
        <div class="progress-breakdown-icon">🧠</div>

        <div>
            <h5>Quizzes</h5>
            <p>@ViewBag.CompletedQuizzes / @ViewBag.TotalQuizzes complete</p>
        </div>
    </div>

</div>

<div class="dashboard-card">
    <h3>Recent Achievements</h3>

    @if (ViewBag.RecentAchievements.Count == 0)
    {
        <p>No achievements unlocked yet. Complete lessons and challenges to earn rewards.</p>
    }
    else
    {
        <div class="achievement-grid">
            @foreach (var userAchievement in ViewBag.RecentAchievements)
            {
                <div class="achievement-card unlocked">
                    <div class="achievement-icon">🏆</div>
                    <h4>@userAchievement.Achievement.Title</h4>
                    <p>@userAchievement.Achievement.Description</p>
                    <span>+@userAchievement.Achievement.XPReward XP</span>
                </div>
            }
        </div>
    }
</div>

<br />

<div class="dashboard-card">
    <h3>All Achievements</h3>

    <div class="achievement-grid">
        @foreach (var achievement in ViewBag.Achievements)
        {
            bool unlocked = ViewBag.UnlockedAchievementIds.Contains(achievement.AchievementID);

            <div class="achievement-card @(unlocked ? "unlocked" : "locked")">
                <div class="achievement-icon">
                    @(unlocked ? "🏆" : "🔒")
                </div>

                <h4>@achievement.Title</h4>
                <p>@achievement.Description</p>

                @if (unlocked)
                {
                    <span>Unlocked · +@achievement.XPReward XP</span>
                }
                else
                {
                    <span>Locked</span>
                }
            </div>
        }
    </div>
</div>
    
</div>